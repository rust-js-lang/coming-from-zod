+  for (const segment of path) {
+    if (typeof segment === "number") {
+      f.write("[");
+      $writeInteger(f, segment);
+      f.write("]");
+    } else {
+      f.write(separator);
+      f.write(segment === null ? "?" : (segment.variant ?? segment));
+    }
+    separator = ".";
+  }
+}
